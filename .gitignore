# ==========================
# SoulSync project ignore rules
# ==========================

# Secrets / environment files
.env
.env.*
*.pem
includes/config.php
includes/db.php
app/includes/db.php
app/viewer/google-auth.php

# Runtime / uploaded content
uploads/
media/
public/uploads/
*.log
error_log
cache/
tmp/

# Dependency / build artifacts
node_modules/
vendor/
coverage/
.next/
out/
build/

# IDE / editor / OS files
.vscode/
.idea/
.DS_Store
.claude/
Thumbs.db

# Temporary / backup files
*.tmp
*.bak
*.swp
*.swo
*.orig

# Archives usually not committed
*.zip
*.tar.gz
*.rar

# Optional project-specific exclusions
login.php
